# Server Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rentora

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_123456
JWT_EXPIRES_IN=7d
BETTER_AUTH_SECRET=your_better_auth_secret_placeholder_key_32_chars
BETTER_AUTH_URL=http://localhost:5000

# Third-Party Integrations
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/customer/rentals?status=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/equipment?status=cancelled
IMGBB_API_KEY=placeholder_imgbb_key
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# Optional Development Seeding (Strictly ignored/blocked when NODE_ENV=production)
# SEED_ADMIN_EMAIL=dev-admin@rentora.local
# SEED_ADMIN_PASSWORD=YourSecureDevSeedPassword123!
